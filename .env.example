# Canonical origin (apex domain, no trailing slash). Used for canonical URLs, the sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://pizzanote.dev

# Optional: comments (giscus). Get the IDs from https://giscus.app after enabling Discussions on the repo.
NEXT_PUBLIC_GISCUS_REPO=pizza6inch/PizzaNote
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Comments
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Optional: Google Analytics 4 measurement ID (G-…). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# Optional: view counter (Upstash Redis, added from the Vercel Marketplace).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
